datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model RawNews {
  id              String   @id @default(uuid())
  sourceId        String   @unique // Dùng để check trùng (ví dụ ID của bài viết trên Reddit)
  platform        String // reddit, douyin, youtube...
  subreddit       String? // Có thể null nếu cào từ nguồn khác
  originalTitle   String   @db.Text
  originalContent String   @db.Text
  mediaUrl        String   @db.Text
  permalink       String   @db.Text
  status          String   @default("PENDING") // PENDING, PROCESSED, FAILED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sourceId])
}
